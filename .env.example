# Public production URL, without a trailing slash.
# Used for canonical URLs, Open Graph tags, the RSS feed, and the sitemap.
# Replace this before deploying.
SITE_URL=https://example.com

# Form service endpoint. Use a Formspree form URL or the Web3Forms endpoint.
# Example Formspree: https://formspree.io/f/xxxxxxxx
# Example Web3Forms: https://api.web3forms.com/submit
PUBLIC_FORM_ENDPOINT=

# Web3Forms only: the access key (public by design). Leave blank for Formspree.
PUBLIC_FORM_ACCESS_KEY=

# Privacy-friendly analytics. Off by default: off | plausible | cloudflare
PUBLIC_ANALYTICS=off
# Required when PUBLIC_ANALYTICS=plausible
PUBLIC_ANALYTICS_DOMAIN=
# Required when PUBLIC_ANALYTICS=cloudflare
PUBLIC_CLOUDFLARE_ANALYTICS_TOKEN=
