---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { site } from "../data/site";

interface Props {
  title: string;
  description: string;
  type?: "website" | "article";
  noindex?: boolean;
  publishedTime?: string;
}

const {
  title,
  description,
  type = "website",
  noindex = false,
  publishedTime,
} = Astro.props;

const siteUrl = Astro.site ?? new URL("https://example.com");
const canonical = new URL(Astro.url.pathname, siteUrl);
const socialImage = new URL("/og.png", siteUrl);
const rssUrl = new URL("/rss.xml", siteUrl);

const analytics = (import.meta.env.PUBLIC_ANALYTICS ?? "off").toLowerCase();
const analyticsDomain = (import.meta.env.PUBLIC_ANALYTICS_DOMAIN ?? "").trim();
const cloudflareToken = (
  import.meta.env.PUBLIC_CLOUDFLARE_ANALYTICS_TOKEN ?? ""
).trim();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={site.name} />
    <link rel="canonical" href={canonical.href} />
    <link rel="alternate" type="application/rss+xml" title={`${site.name} — build log`} href={rssUrl.href} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="generator" content={Astro.generator} />
    {noindex && <meta name="robots" content="noindex" />}

    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:image" content={socialImage.href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${site.name} — building in public. An AI operating layer for Indian bus and logistics operators.`} />
    {publishedTime && <meta property="article:published_time" content={publishedTime} />}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage.href} />
    <meta name="twitter:image:alt" content={`${site.name} — building in public. An AI operating layer for Indian bus and logistics operators.`} />

    <meta name="theme-color" content="#ffffff" />

    {analytics === "plausible" && analyticsDomain && (
      <script
        is:inline
        defer
        data-domain={analyticsDomain}
        src="https://plausible.io/js/script.js"
      ></script>
    )}
    {analytics === "cloudflare" && cloudflareToken && (
      <script
        is:inline
        defer
        src="https://static.cloudflareinsights.com/beacon.min.js"
        data-cf-beacon={JSON.stringify({ token: cloudflareToken })}
      ></script>
    )}
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />
    <script>
      import { setupMotion } from "../scripts/motion";

      setupMotion();
    </script>
  </body>
</html>
