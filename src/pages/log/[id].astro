---
import { render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { site } from "../../data/site";
import {
  formatDate,
  getLogEntries,
  isoDate,
  logPath,
  type LogEntry,
} from "../../lib/log";

export async function getStaticPaths() {
  const entries = await getLogEntries();
  return entries.map((entry) => ({
    params: { id: entry.id },
    props: { entry },
  }));
}

interface Props {
  entry: LogEntry;
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---

<BaseLayout
  title={`${entry.data.title} — ${site.name}`}
  description={entry.data.summary}
  type="article"
  publishedTime={entry.data.date.toISOString()}
  noindex={entry.data.draft}
>
  <article>
    <header class="entry-header">
      <div class="container">
        <a class="back-link" href="/log/">← All entries</a>
        <div class="log-meta">
          <time datetime={isoDate(entry.data.date)}>
            {formatDate(entry.data.date)}
          </time>
          {
            entry.data.draft && (
              <span class="badge-draft" title="Draft — excluded from the RSS feed">
                Draft
              </span>
            )
          }
        </div>
        <h1 class="entry-title">{entry.data.title}</h1>
        <p class="entry-summary">{entry.data.summary}</p>
        {
          entry.data.tags.length > 0 && (
            <ul class="tags" aria-label="Tags">
              {entry.data.tags.map((tag) => (
                <li>#{tag}</li>
              ))}
            </ul>
          )
        }
        {
          entry.data.draft && (
            <p class="draft-note">
              This entry is a draft. It is not in the RSS feed or sitemap, and
              search engines are asked not to index it.
            </p>
          )
        }
      </div>
    </header>

    <div class="entry-body">
      <div class="container">
        {
          entry.data.image && (
            <img
              class="entry-image"
              src={entry.data.image}
              alt={entry.data.imageAlt ?? ""}
              loading="lazy"
              decoding="async"
            />
          )
        }
        <div class="prose">
          <Content />
        </div>

        <footer class="entry-footer">
          <p>Thanks for reading.</p>
          <p><a href="/log/">All entries →</a></p>
        </footer>
      </div>
    </div>
  </article>
</BaseLayout>
