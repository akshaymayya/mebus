---
import BaseLayout from "../layouts/BaseLayout.astro";
import ContactForm from "../components/ContactForm.astro";

const problems = [
  {
    title: "Scattered Information",
    copy: "Important operational information is spread across different tools, records and conversations.",
  },
  {
    title: "Delayed Coordination",
    copy: "Problems during trips can take time to reach the right people.",
  },
  {
    title: "Limited Operational Visibility",
    copy: "It can be difficult to understand what is happening across routes, trips and teams.",
  },
  {
    title: "Unclear Accountability",
    copy: "Follow-ups and responsibilities can become difficult to track.",
  },
  {
    title: "Financial Visibility",
    copy: "Understanding the actual performance and expenses of individual trips and routes can be challenging.",
  },
  {
    title: "Customer Issue Follow-ups",
    copy: "Complaints, cancellations and refunds can require coordination across multiple people.",
  },
];

const beliefs = [
  {
    title: "Information should be connected.",
    copy: "Business information should not exist in isolated places. Operational records, trip details, customer concerns and financial information should come together to provide a clearer understanding of the business.",
  },
  {
    title: "Clarity should come before complexity.",
    copy: "Technology should make everyday work easier to understand, not introduce more layers of complexity. People should be able to find the information they need without navigating unnecessary processes.",
  },
  {
    title: "Every responsibility should have clarity.",
    copy: "When something needs attention, the people involved should understand what happened, who is responsible and what needs to happen next. Good coordination starts with clear responsibilities.",
  },
  {
    title: "Decisions should have context.",
    copy: "Business decisions are better supported when people can understand what is happening across their operations. Information should help bring context to decisions rather than simply produce more reports.",
  },
  {
    title: "Technology should adapt to real operations.",
    copy: "Every bus business has its own workflows, people and challenges. Technology should respect these realities and support existing ways of working instead of forcing unnecessary change.",
  },
  {
    title: "Progress should be practical.",
    copy: "Improving operations does not always require changing everything at once. Meaningful progress comes from understanding real problems and addressing them thoughtfully, one step at a time.",
  },
];
---

<BaseLayout
  title="mebus — Bus operations, understood"
  description="Bus operations become harder when information is scattered."
  showHeader={false}
  showFooter={false}
>
  <div class="marketing-home">
    <section class="home-hero" aria-labelledby="home-title">
      <div class="home-hero-inner hero-copy">
        <a class="home-wordmark" href="#main" aria-label="mebus home">mebus<span>.</span></a>
        <h1 id="home-title">Bus operations become harder when information is scattered.</h1>
        <a class="home-hero-link" href="#connect">Get in touch <span aria-hidden="true">↗</span></a>
      </div>
      <span class="hero-index" aria-hidden="true">01 / 05</span>
    </section>

    <section class="section home-section home-problems" id="problems" aria-labelledby="problems-title">
      <div class="container">
        <header class="section-head">
          <p class="home-kicker">01 — The problem</p>
          <div>
            <h2 id="problems-title">The everyday challenges of bus operations</h2>
          </div>
        </header>
        <ol class="steps problem-cards">
          {problems.map((problem, index) => (
            <li>
              <div class="step-top"><span class="step-number">0{index + 1}</span></div>
              <h3 class="step-title">{problem.title}</h3>
              <p>{problem.copy}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <section class="section home-section home-manifesto" id="manifesto" aria-labelledby="manifesto-title">
      <div class="container">
        <header class="section-head">
          <p class="home-kicker">02 — What we believe</p>
          <div>
            <h2 id="manifesto-title">A better way to understand bus operations.</h2>
            <p class="section-intro">We believe better operations begin with better understanding.</p>
          </div>
        </header>

        <div class="manifesto-intro">
          <p>Running a bus business involves more than managing buses, routes and schedules. Every day, people make decisions, coordinate teams, handle unexpected situations and keep operations moving.</p>
          <p>But when information is scattered across different systems, records and conversations, getting a complete picture becomes difficult.</p>
          <p>Important details can get overlooked. Follow-ups can become unclear. Decisions may have to be made without the full context.</p>
          <p>We believe it doesn't have to be this way.</p>
        </div>

        <ol class="principles manifesto-beliefs">
          {beliefs.map((belief, index) => (
            <li>
              <span class="principle-number">0{index + 1}</span>
              <div>
                <h3 class="principle-title">{belief.title}</h3>
                <p class="principle-copy">{belief.copy}</p>
              </div>
            </li>
          ))}
        </ol>

        <div class="working-towards">
          <p class="home-kicker">What we are working towards</p>
          <div>
            <p>We are working towards a more connected way of understanding and managing bus operations.</p>
            <p>A place where information is easier to find, operational situations are easier to follow, responsibilities are clearer and decisions have better context.</p>
            <p>Not technology for the sake of technology.<br />Not more complexity.<br />Just a more thoughtful way to manage the everyday realities of running a bus business.</p>
          </div>
        </div>

        <p class="home-principle-line">Understand the operation. Connect the information. Make better decisions.</p>
        <p class="home-attribution">That is the thinking behind mebus.</p>
      </div>
    </section>

    <section class="section home-section home-connect" id="connect" aria-labelledby="connect-title">
      <div class="container">
        <header class="section-head">
          <p class="home-kicker">03 — Connect</p>
          <div>
            <h2 id="connect-title">Let's understand your operations.</h2>
            <p class="section-intro">Have a challenge in managing your bus operations? We'd be interested in hearing how your business works and what could work better.</p>
          </div>
        </header>
        <div class="contact-grid"><ContactForm /></div>
      </div>
    </section>
  </div>

  <footer slot="page-footer" class="home-footer" data-home-footer>
    <div class="home-footer-inner">
      <a class="home-footer-brand" href="#main" aria-label="mebus home">mebus<span>.</span></a>
      <a class="home-footer-link" href="#connect">Contact <span aria-hidden="true">↗</span></a>
    </div>
  </footer>
</BaseLayout>
