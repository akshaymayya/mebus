---
import { roadmap } from "../data/roadmap";
---

<ol class="timeline" aria-label="Build plan">
  {
    roadmap.map((stage) => (
      <li class="stage">
        <p class="stage-phase">Stage {stage.phase}</p>
        <h3>{stage.title}</h3>
        <p>{stage.description}</p>
      </li>
    ))
  }
</ol>
